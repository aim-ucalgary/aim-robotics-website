# Copy this file to `.env` for local development (`npm run dev:full`), and add the same
# names in Netlify → Site configuration → Environment variables for the live site.
# Never commit `.env`; it holds secrets.

# Neon: pooled connection string for the `aim_app` role.
#   Local .env  → the `dev` branch.   Netlify → the `production` branch.
DATABASE_URL=

# Better Auth
#   Secret: a long random string. Generate one with:  openssl rand -base64 32
#   URL: where the site runs. Local: http://localhost:8888   Live: https://<your-site>
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8888

# Google sign-in (Google Cloud Console → Credentials → OAuth client ID, "Web application")
#   Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (optional; Microsoft Entra → App registrations)
#   Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/microsoft
#   Leave blank to offer Google only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
